# Local development (used automatically via .env.development)
# VITE_API_URL=http://127.0.0.1:8000

# Production: set this on Vercel (Project → Settings → Environment Variables)
# to your Render HTTPS URL with no trailing slash, then Redeploy.
# Example: https://your-service.onrender.com
VITE_API_URL=https://your-service.onrender.com
